{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "moyu-fish-tank",
  "version": "0.1.0",
  "identifier": "com.moyu.fishtank",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "overlay",
        "url": "overlay.html",
        "title": "摸，摸鱼 · 桌面鱼层",
        "width": 1280,
        "height": 800,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": false,
        "focus": false,
        "visible": false
      },
      {
        "label": "manager",
        "url": "index.html",
        "title": "摸，摸鱼",
        "width": 920,
        "height": 660,
        "minWidth": 780,
        "minHeight": 580,
        "transparent": true,
        "decorations": false,
        "shadow": true,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
